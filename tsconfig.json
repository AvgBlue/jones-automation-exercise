{
   "compilerOptions": {
     "target": "ES2022",
     "module": "NodeNext",
     "moduleResolution": "NodeNext",
     "strict": true,
     "esModuleInterop": true,
     "skipLibCheck": true,
     "outDir": "./dist",
     "rootDir": "./",
     "resolveJsonModule": true,
     "declaration": false,
     "noEmit": false
   },
   "include": ["test-site/**/*.ts", "test-site/**/*.js"],
   "exclude": ["node_modules"]
}
